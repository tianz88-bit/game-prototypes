{
  "name": "steroids-alpha-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PLANET_ROOMS",
        "class_name": "PlanetRoom"
      },
      {
        "name": "PLANET_CONFIG",
        "class_name": "PlanetConfig"
      }
    ]
  },
  // The bank (BRIEF.md "Bank and unlocks"). Schema: server/migrations, applied by the deploy workflow.
  "d1_databases": [
    {
      "binding": "STASH",
      "database_name": "steroids-alpha-stash",
      "database_id": "02a083da-e0b9-4ae8-9a7d-d7c0fa292b40",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PlanetRoom"
      ]
    },
    {
      "tag": "v2-config",
      "new_sqlite_classes": [
        "PlanetConfig"
      ]
    }
  ]
}
