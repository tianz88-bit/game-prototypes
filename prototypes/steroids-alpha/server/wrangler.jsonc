{
  "name": "steroids-alpha-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PLANET_ROOMS",
        "class_name": "PlanetRoom"
      },
      {
        "name": "PLANET_CONFIG",
        "class_name": "PlanetConfig"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PlanetRoom"
      ]
    },
    {
      "tag": "v2-config",
      "new_sqlite_classes": [
        "PlanetConfig"
      ]
    }
  ]
}
