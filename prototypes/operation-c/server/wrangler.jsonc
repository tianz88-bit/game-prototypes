{
  "name": "operation-c-online",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": { "directory": "../dist", "run_worker_first": ["/health", "/ws/*"] },
  "durable_objects": { "bindings": [{ "name": "OPERATION_C_ROOMS", "class_name": "OperationCRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OperationCRoom"] }]
}
