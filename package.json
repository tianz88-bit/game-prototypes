{
  "name": "game-prototypes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "prototypes/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && vite",
    "build:packages": "npm run build --workspaces --if-present",
    "prebuild": "npm run build:packages",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "node scripts/generate-versions.js && npm run build:packages",
    "typecheck": "tsc --noEmit",
    "fetch:assets": "node scripts/fetch-assets.js",
    "pack:assets": "node scripts/pack-assets.js",
    "simulate": "node scripts/run-simulate.mjs",
    "build:punchies-playable": "vite build --config prototypes/punchies-playable/vite.config.ts",
    "tuner:github": "node scripts/start-punchies-github.mjs",
    "test:tuner:github": "node scripts/test-punchies-github.mjs",
    "test:tuner:base": "node scripts/test-punchies-base-history.mjs",
    "test:tuner:preview": "node scripts/test-punchies-perceived-stats.mjs",
    "build:punchies:standard": "npm run build:packages && node scripts/build-punchies-profile.mjs standard",
    "build:punchies:compact": "npm run build:packages && node scripts/build-punchies-profile.mjs compact",
    "steroids:lab": "node scripts/start-steroids-lab.mjs",
    "test:steroids:live": "node scripts/test-steroids-live-config.mjs"
  },
  "dependencies": {
    "@tweakpane/core": "^2.0.5",
    "phaser": "^3.87.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "trystero": "^0.25.3",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "adm-zip": "^0.6.0",
    "free-tex-packer-cli": "^0.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
